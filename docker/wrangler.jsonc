{
  "name": "attic",
  "main": "src/index.js",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "GALLERY_BUCKET",
      "bucket_name": "gallery"
    },
    {
      "binding": "LEGACY_BUCKET",
      "bucket_name": "legacy"
    }
  ]
}
