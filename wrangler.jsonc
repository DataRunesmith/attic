{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "attic",
  "main": "dist/worker.js",
  "compatibility_date": "2026-03-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "__PUBLIC_HOST__",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "GALLERY_BUCKET",
      "bucket_name": "__GALLERY_BUCKET__"
    },
    {
      "binding": "LEGACY_BUCKET",
      "bucket_name": "__LEGACY_BUCKET__"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "WORKERS_API_TOKEN",
      "store_id": "__SECRETS_STORE_ID__",
      "secret_name": "WORKERS_API_TOKEN"
    }
  ],
  "vars": {
    "CF_ACCESS_AUD": "__CF_ACCESS_AUD__"
  },
  "account_id": "__CLOUDFLARE_ACCOUNT_ID__"
}
