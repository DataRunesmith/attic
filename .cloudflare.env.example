# Copy this file to .cloudflare.env and fill in your account-specific values.
# Keep .cloudflare.env private; it is ignored by Git.
# CLOUDFLARE_API_TOKEN is a user-scoped token used only by cloudflare:configure.
# Required token permissions: Workers Builds Configuration (Edit), Workers Scripts (Read).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WORKER_NAME=attic

# Build-time values imported into the connected Workers Build. Access is enforced by Cloudflare Workers Access.
PUBLIC_HOST=images.example.com
PUBLIC_ORIGIN=https://images.example.com
GALLERY_BUCKET=gallery
LEGACY_BUCKET=legacy
SECRETS_STORE_ID=
# Optional: pin native Workers Access requests to this application audience.
CF_ACCESS_AUD=
